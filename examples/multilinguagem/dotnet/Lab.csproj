<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lab</RootNamespace>
    <AssemblyName>Lab</AssemblyName>
    <!-- Sem dados de cultura na imagem: o Comprovante.cs formata dinheiro e
         data com NumberFormatInfo/InvariantCulture montados na mao, de
         proposito, para nao depender de locale que a imagem slim nao tem. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- AWSSDK 3.7: e a linha que o guia 03 descreve, com o
         FallbackCredentialsFactory e os nomes de tipo que o Diagnostico.cs
         imprime (AssumeRoleWithWebIdentityCredentials, URIBased...).
         Na V4 do SDK esse ponto de entrada mudou de nome - se voce migrar,
         o Diagnostico.cs e o arquivo que precisa ser ajustado. -->
    <PackageReference Include="AWSSDK.SQS" Version="3.7.*" />
    <PackageReference Include="AWSSDK.SimpleNotificationService" Version="3.7.*" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="3.7.*" />
    <PackageReference Include="AWSSDK.SecretsManager" Version="3.7.*" />
  </ItemGroup>

</Project>
