{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LerApenasOPrefixoDeEntrada",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::asa-dev-cash-cobranca-entrada/entrada/*"
    },
    {
      "Sid": "ListarApenasEssePrefixo",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::asa-dev-cash-cobranca-entrada",
      "Condition": {
        "StringLike": { "s3:prefix": "entrada/*" }
      }
    }
  ]
}
